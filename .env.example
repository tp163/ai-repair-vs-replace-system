# --- LLM provider -----------------------------------------------------------
# demo   = no LLM needed, agents use template/deterministic logic (default)
# ollama = local free LLM (install from ollama.com, then: ollama pull llama3.1:8b)
LLM_PROVIDER=demo
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Optional: any OpenAI-compatible cloud API instead of Ollama
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# --- Data -------------------------------------------------------------------
# Path to your Sri Lankan phone dataset (JSON or CSV)
PHONE_DATA_PATH=data/phones_placeholder.json

# --- Market research --------------------------------------------------------
# true = Market Research Agent also runs free DuckDuckGo live price searches
ENABLE_LIVE_SEARCH=false
LIVE_SEARCH_RESULTS=3

# --- Recommendation behaviour ------------------------------------------------
TOP_K=3
MAX_CANDIDATES=10
